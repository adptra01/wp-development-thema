		{
			"name": "5 — Authentication Methods",
			"description": "Three authentication methods supported. Use whichever fits your integration best.",
			"item": [
				{
					"name": "Query Param — ?api_key=KEY",
					"event": [{"listen": "test", "script": {"exec": [
						"pm.test('HTTP 200', () => pm.response.to.have.status(200));"
					], "type": "text/javascript"}}],
					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts?api_key={{api_key}}&per_page=1&nocache=1",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"api_key","value":"{{api_key}}"},{"key":"per_page","value":"1"},{"key":"nocache","value":"1"}]
					}}
				},
				{
					"name": "Header — X-API-Key: KEY",
					"request": {"method": "GET", "header": [
						{"key":"X-API-Key","value":"{{api_key}}"}
					], "url": {
						"raw": "{{base_url}}/posts?per_page=1&nocache=1",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"per_page","value":"1"},{"key":"nocache","value":"1"}]
					}}
				},
