				},
				{
					"name": "GET /posts — Sorted by Title ASC",
					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts?api_key={{api_key}}&orderby=title&order=ASC&per_page=5",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"api_key","value":"{{api_key}}"},{"key":"orderby","value":"title"},{"key":"order","value":"ASC"},{"key":"per_page","value":"5"}]
					}}
				},
				{
					"name": "GET /posts — Filter by Author",
					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts?api_key={{api_key}}&author=1",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"api_key","value":"{{api_key}}"},{"key":"author","value":"1"}]
					}}
				},
				{
					"name": "GET /posts — Bypass Cache (nocache=1)",
					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts?api_key={{api_key}}&per_page=1&nocache=1",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"api_key","value":"{{api_key}}"},{"key":"per_page","value":"1"},{"key":"nocache","value":"1"}]
					}}
				},
				{
					"name": "GET /posts/{id} — Single Post by ID",
					"event": [{"listen": "test", "script": {"exec": [
						"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
						"pm.test('post object returned', () => { const j = pm.response.json(); pm.expect(j.post).to.be.an('object'); pm.expect(j.post.id).to.eql(1); });"
					], "type": "text/javascript"}}],
					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts/1?api_key={{api_key}}",
						"host": ["{{base_url}}"], "path": ["posts","1"],
