		{
			"name": "6 — CORS & Preflight",
			"description": "CORS headers included in all responses. Configurable origins via wp-config.php constant CUSTOM_API_ALLOWED_ORIGINS.",
			"item": [
				{
					"name": "OPTIONS /posts — CORS Preflight",
					"event": [{"listen": "test", "script": {"exec": [
						"pm.test('HTTP 204', () => pm.response.to.have.status(204));",
						"pm.test('CORS headers present', () => { pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.exist; pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('GET'); });"
					], "type": "text/javascript"}}],
					"request": {"method": "OPTIONS", "header": [
						{"key":"Origin","value":"https://example.com"},
						{"key":"Access-Control-Request-Method","value":"GET"}
					], "url": {
						"raw": "{{base_url}}/posts",
						"host": ["{{base_url}}"], "path": ["posts"]
					}}
				}
			]
		}
