					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts/hello-world?api_key={{api_key}}",
						"host": ["{{base_url}}"], "path": ["posts","hello-world"],
						"query": [{"key":"api_key","value":"{{api_key}}"}]
					}}
				},
				{
