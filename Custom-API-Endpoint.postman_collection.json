		{
			"name": "4 — SEO Metadata",
			"description": "SEO data from Yoast SEO, Rank Math, or All in One SEO. Auto-detects which plugin is active. Requires 'seo' permission.",
			"item": [
				{
					"name": "GET /seo/{id} — SEO Data for Post",
					"event": [{"listen": "test", "script": {"exec": [
						"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
						"pm.test('SEO data present', () => { const d = pm.response.json().data; pm.expect(d).to.be.an('object'); const seo = d.yoast || d.rank_math || d.aioseo; if(seo) { pm.test('has title', () => pm.expect(seo).to.have.property('title')); pm.test('has description', () => pm.expect(seo).to.have.property('description')); } });"
					], "type": "text/javascript"}}],
					"request": {"method": "GET", "header": [], "url": {
