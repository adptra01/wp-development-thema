{
	"info": {
		"name": "Custom API Endpoint v1.0",
		"description": "WordPress Custom API Endpoint — Alternative REST API that bypasses /wp-json/ firewall restrictions on InfinityFree and similar hosting.\n\n**Base URL:** `https://your-site.com/wp-api-proxy.php`\n\n**Authentication:** API Key required for all endpoints except `/status`. Three auth methods supported:\n- Query parameter: `?api_key=YOUR_KEY`\n- HTTP header: `X-API-Key: YOUR_KEY`\n- Bearer token: `Authorization: Bearer YOUR_KEY`\n\n**Rate Limiting:** 120 requests per 60 seconds per API key (configurable via wp-config.php).\n**Response Caching:** GET responses cached for 60 seconds. Bypass with `?nocache=1`.\n**Page Size Limit:** Maximum 100 items per request.\n\n**Manage Keys:** WP Admin → Settings → Custom API Endpoint\n\n---\n**v1.0 Features:** RESTful path-based routing, API key auth with permission scopes, Yoast/RankMath/AIOSEO SEO support, response caching, rate limiting, CORS, access logging.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{"key": "value", "value": "YOUR_API_KEY_HERE", "type": "string"},
			{"key": "key", "value": "api_key", "type": "string"}
		]
	},
	"variable": [
		{"key": "base_url", "value": "https://your-site.com/wp-api-proxy.php"},
		{"key": "api_key", "value": "YOUR_API_KEY_HERE"}
	],
	"item": [
		{
			"name": "0 — Status (No Auth)",
			"description": "Health check endpoint — no authentication required. Returns WordPress and PHP version info.",
			"item": [
				{
					"name": "GET /status — Health Check",
					"event": [{"listen": "test", "script": {"exec": [
						"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
						"pm.test('JSON response', () => pm.response.to.have.jsonBody());",
						"pm.test('status == ok', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('ok'); });",
						"pm.test('wordpress version present', () => { pm.expect(pm.response.json().wordpress).to.be.a('string'); });",
						"pm.test('php version present', () => { pm.expect(pm.response.json().php).to.be.a('string'); });"
					], "type": "text/javascript"}}],
					"request": {
						"method": "GET", "header": [],
						"url": {"raw": "{{base_url}}/status", "host": ["{{base_url}}"], "path": ["status"]}
					}
				}
			]
		},
		{
			"name": "1 — Posts & Content",
			"description": "Retrieve posts, pages, and custom post types. Supports pagination, filtering, search, sorting.",
			"item": [
				{
					"name": "GET /posts — List All Posts (default)",
					"event": [{"listen": "test", "script": {"exec": [
						"pm.test('HTTP 200', () => pm.response.to.have.status(200));",
						"pm.test('Has pagination fields', () => { const j = pm.response.json(); pm.expect(j.total).to.be.a('number'); pm.expect(j.page).to.be.a('number'); pm.expect(j.total_pages).to.be.a('number'); });",
						"pm.test('results is array', () => { pm.expect(pm.response.json().results).to.be.an('array'); });",
						"const r = pm.response.json(); if (r.results.length > 0) {",
						"  pm.test('post has required fields', () => { const p = r.results[0]; pm.expect(p).to.include.all.keys('id','title','slug','content','link','author','excerpt'); });",
						"}"
					], "type": "text/javascript"}}],
					"request": {"method": "GET", "header": [], "url": {
						"raw": "{{base_url}}/posts?api_key={{api_key}}&per_page=10",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"api_key","value":"{{api_key}}"},{"key":"per_page","value":"10"}]
					}}
				},
				{
					"name": "GET /posts — With Metadata & Taxonomies",
