						"raw": "{{base_url}}/posts?api_key={{api_key}}&per_page=3&include_meta=1&include_taxonomies=1",
						"host": ["{{base_url}}"], "path": ["posts"],
						"query": [{"key":"api_key","value":"{{api_key}}"},{"key":"per_page","value":"3"},{"key":"include_meta","value":"1"},{"key":"include_taxonomies","value":"1"}]
					}}
				},
				{
					"name": "GET /posts — Raw Content (skip the_content filter)",
